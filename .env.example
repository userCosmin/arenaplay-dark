# Site
VITE_SITE_URL=https://www.arenaplay.ro

# Analytics (leave empty to disable in development)
VITE_GA4_ID=G-XXXXXXXXXX
VITE_GTM_ID=GTM-XXXXXXX
VITE_FB_PIXEL_ID=00000000000000000
VITE_CLARITY_ID=xxxxxxxxxx

# Forms / future API integration
VITE_API_BASE_URL=https://api.arenaplay.ro

# Cloudflare Turnstile (anti-spam captcha on the Petreceri & Loc de joacă
# reservation forms — same widget used on arenaplay.ro/rezervare). Create a
# widget at dash.cloudflare.com/?to=/:account/turnstile, then set:
#   - VITE_TURNSTILE_SITE_KEY here (public, safe to expose client-side)
#   - TURNSTILE_SECRET_KEY as a SERVER-SIDE variable in Cloudflare Pages
#     (Settings -> Environment variables), never in this file
# Until both are set, the forms work without a captcha (no widget renders,
# no server-side check is enforced) — this is optional, not required to ship.
VITE_TURNSTILE_SITE_KEY=

# Email delivery (Cloudflare Pages Function - functions/api/lead.ts)
# RESEND_API_KEY and TURNSTILE_SECRET_KEY are SECRETS — set them as SERVER-SIDE
# environment variables in the Cloudflare Pages dashboard. This file only
# documents them; do not put real secrets in .env.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# TURNSTILE_SECRET_KEY=0x_xxxxxxxxxxxx (pairs with VITE_TURNSTILE_SITE_KEY above)
#
# LEAD_NOTIFICATION_EMAIL and RESEND_FROM_EMAIL are plain (non-secret) values —
# once wrangler.toml declares any binding, Cloudflare Pages manages non-secret
# vars through the config file instead of the dashboard, so these two are set
# in wrangler.toml under [vars] / [env.production.vars], not here.

# Admin panel (Cloudflare Pages Functions - functions/api/admin/*)
# Set these as SERVER-SIDE environment variables in the Cloudflare Pages dashboard
# (Settings -> Environment variables), or in a git-ignored .dev.vars file for
# local `wrangler pages dev`. Every submission from the 5 site forms is stored
# in the D1 database "arena-play-leads" (see wrangler.toml) and can be viewed/
# managed at /admin, gated by ADMIN_PASSWORD.
# ADMIN_PASSWORD=choose-a-strong-password
# ADMIN_SESSION_SECRET=generate-a-long-random-string (e.g. `openssl rand -hex 32`)
