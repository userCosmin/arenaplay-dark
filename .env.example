# Site
VITE_SITE_URL=https://www.arenaplay.ro

# Analytics (leave empty to disable in development)
VITE_GA4_ID=G-XXXXXXXXXX
VITE_GTM_ID=GTM-XXXXXXX
VITE_FB_PIXEL_ID=00000000000000000
VITE_CLARITY_ID=xxxxxxxxxx

# Forms / future API integration
VITE_API_BASE_URL=https://api.arenaplay.ro

# Email delivery (Cloudflare Pages Function - functions/api/lead.ts)
# Set these as SERVER-SIDE environment variables in the Cloudflare Pages dashboard,
# not here. This file only documents them; do not put real secrets in .env.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# LEAD_NOTIFICATION_EMAIL=rusanadrian1973@gmail.com
# RESEND_FROM_EMAIL=Arena Play <onboarding@resend.dev>

# Admin panel (Cloudflare Pages Functions - functions/api/admin/*)
# Set these as SERVER-SIDE environment variables in the Cloudflare Pages dashboard
# (Settings -> Environment variables), or in a git-ignored .dev.vars file for
# local `wrangler pages dev`. Every submission from the 5 site forms is stored
# in the D1 database "arena-play-leads" (see wrangler.toml) and can be viewed/
# managed at /admin, gated by ADMIN_PASSWORD.
# ADMIN_PASSWORD=choose-a-strong-password
# ADMIN_SESSION_SECRET=generate-a-long-random-string (e.g. `openssl rand -hex 32`)
